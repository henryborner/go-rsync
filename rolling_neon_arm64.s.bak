// NEON checksum: 32B/iter, raw sums (CHAR_OFFSET post-correction in Go).
//
// Go 1.25 ARM64 asm lacks VUADDLP, VUMULL, VUMULL2, VSADDLP, VMUL mnemonics.
// The loop body uses WORD encodings for those. .S4 instructions use mnemonics.
//
// Reference: Go issue #78498 (VUMULL/VUMULL2 landed April 2026 on master,
// available in Go 1.27).

#include "textflag.h"

// func checksum1NEON(data []byte, s1, s2 *uint32) bool
TEXT ·checksum1NEON(SB), NOSPLIT, $0-41
	MOVD    data+0(FP), R0       // R0 = data ptr
	MOVD    data_len+8(FP), R1   // R1 = len
	CMP     $32, R1
	BLT     bail

	MOVD    s1+24(FP), R2        // R2 = *s1
	MOVD    s2+32(FP), R3        // R3 = *s2

	// ── Load weight tables ──
	MOVD    $w32_neon<>(SB), R4
	VLD1    (R4), [V18.B16]      // V18 = weights [32..17]
	ADD     $16, R4, R4
	VLD1    (R4), [V19.B16]      // V19 = weights [16..1]

	// ── Save initial values ──
	MOVWU   (R2), R5             // R5 = init_s1
	MOVWU   (R3), R6             // R6 = init_s2

	// ── Zero accumulators ──
	VEOR    V12.B16, V12.B16, V12.B16   // Σ weighted
	VEOR    V4.B16, V4.B16, V4.B16      // Σ s1_before_k
	VEOR    V14.B16, V14.B16, V14.B16   // running byte-sum

	// Preload first 32B
	VLD1    (R0), [V2.B16]       // V2 = data[0:16]
	VLD1    16(R0), [V3.B16]     // V3 = data[16:32]

	AND     $~31, R1, R7         // len & ~31
	LSR     $5, R7, R7           // iterations = len/32
	MOVD    R7, R12              // R12 = N (save for exit)
	ADD     $32, R0              // advance ptr

loop:
	// ── s1: byte sum → 4×int32 delta_s1 (.H8 ops → WORD) ──
	WORD    $0x6E201040          // VUADDLP V0.8H, V2.16B
	WORD    $0x6E201061          // VUADDLP V1.8H, V3.16B
	WORD    $0x4E618400          // VADD    V0.8H, V0.8H, V1.8H
	WORD    $0x4E601000          // VSADDLP V0.4S, V0.8H

	// ── s2: accumulate s1_before (32-bit, mnemonic) ──
	VADD    V4.S4, V4.S4, V14.S4

	// ── s2 weighted: first half × weights [32..17] (.H8 → WORD) ──
	WORD    $0x2E32C045          // VUMULL  V5.8H, V2.8B, V18.8B
	WORD    $0x6E32C046          // VUMULL2 V6.8H, V2.16B, V18.16B
	WORD    $0x4E66BCA5          // VADDP   V5.8H, V5.8H, V6.8H
	WORD    $0x4E6010A5          // VSADDLP V5.4S, V5.8H

	// ── s2 weighted: second half × weights [16..1] (.H8 → WORD) ──
	WORD    $0x2E33C067          // VUMULL  V7.8H, V3.8B, V19.8B
	WORD    $0x6E33C068          // VUMULL2 V8.8H, V3.16B, V19.16B
	WORD    $0x4E68BCE7          // VADDP   V7.8H, V7.8H, V8.8H
	WORD    $0x4E6010E7          // VSADDLP V7.4S, V7.8H

	// ── Merge + accumulate (32-bit, mnemonic) ──
	VADD    V5.S4, V5.S4, V7.S4
	VADD    V12.S4, V12.S4, V5.S4

	// Prefetch 6 cachelines ahead
	PRFM    PLDL1KEEP, 384(R0)

	// ── s1 update (32-bit, mnemonic) ──
	VADD    V14.S4, V14.S4, V0.S4

	// Next block
	SUB     $1, R7, R7
	BEQ     done
	VLD1    (R0), [V2.B16]
	VLD1    16(R0), [V3.B16]
	ADD     $32, R0
	B       loop

done:
	// ═══════════════════════════════════════
	// Exit (all 32-bit, mnemonics only)
	// ═══════════════════════════════════════
	VADDP   V0.S4, V14.S4, V14.S4
	VADDP   V0.S4, V0.S4, V0.S4
	UMOV    R8, V0.S[0]
	ADD     R5, R8, R8              // s1 = byte_sum + init_s1

	VADDP   V0.S4, V4.S4, V4.S4
	VADDP   V0.S4, V0.S4, V0.S4
	UMOV    R9, V0.S[0]
	LSL     $5, R9, R9              // 32 × Σ s1_before

	MULW    R12, R5, R10
	LSL     $5, R10, R10
	ADD     R10, R9, R9

	VADDP   V0.S4, V12.S4, V12.S4
	VADDP   V0.S4, V0.S4, V0.S4
	UMOV    R10, V0.S[0]
	ADD     R9, R10, R10
	ADD     R6, R10, R10

	MOVW    R8, (R2)
	MOVW    R10, (R3)

	MOVB    $1, ret+40(FP)
	RET

bail:
	MOVB    $0, ret+40(FP)
	RET

// ── Weight table ──
DATA w32_neon<>+0(SB)/8,  $0x191a1b1c1d1e1f20  // 32..25
DATA w32_neon<>+8(SB)/8,  $0x1112131415161718  // 24..17
DATA w32_neon<>+16(SB)/8, $0x090a0b0c0d0e0f10  // 16..9
DATA w32_neon<>+24(SB)/8, $0x0102030405060708  // 8..1
GLOBL w32_neon<>(SB), RODATA|NOPTR, $32
